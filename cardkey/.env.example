# 复制成 .env 使用；或者直接跑 `python manage.py init` 自动生成。
# .env 里有明文密钥，务必加进 .gitignore。

# 管理端密钥，所有 /admin/* 接口要带 X-Admin-Key 头
ADMIN_API_KEY=换成你自己的随机串

# card_pwd 的加密密钥，必须是 Fernet 格式（44 位 base64）
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CARD_FERNET_KEY=

# 数据库。默认 SQLite；生产建议 MySQL（先 pip install pymysql）
# DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/cardkey?charset=utf8mb4

# 卡号长度与分组
CARD_NO_LENGTH=20
CARD_NO_GROUP=4

# 核销限流：60 秒内同一 IP 最多 10 次
REDEEM_RATE_WINDOW=60
REDEEM_RATE_ATTEMPTS=10

# 启动校验限流（客户端每次启动都会调用，阈值放宽）
VERIFY_RATE_WINDOW=60
VERIFY_RATE_ATTEMPTS=30

# 生产环境建议关闭 /docs、/redoc、/openapi.json
ENABLE_DOCS=true

# 只有在 Nginx 等反代后面、且反代会覆写 X-Forwarded-For 时才设 true
TRUST_PROXY=false
